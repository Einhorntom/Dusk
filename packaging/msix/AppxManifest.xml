<?xml version="1.0" encoding="utf-8"?>
<!--
  The MSIX package for the Microsoft Store. scripts/package_msix.ps1 fills in
  {IDENTITY_NAME}, {PUBLISHER}, {PUBLISHER_DISPLAY_NAME}, {DISPLAY_NAME}
  (from packaging/msix/store.json, as reserved in Partner Center) and
  {VERSION}, then packs it with makeappx.

  - Full-trust desktop app: tray, global hotkeys, DDC/CI and WMI need it
    (runFullTrust).
  - %APPDATA%\Dusk and %LOCALAPPDATA%\Dusk are excluded from write
    virtualization (unvirtualizedResources), so the Store version, the zip
    version and the CLI share one hand-editable config.toml, and the logs
    stay where the docs say (SPEC-DAT-1, SPEC-NFR-3).
  - Start with Windows uses the DuskStartup task (SPEC-UI-12).
  - `dusk` stays a command in terminals through an execution alias on the
    main app (a second, Start-menu-hidden app would be "headless", which the
    Store rejects).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:virtualization="http://schemas.microsoft.com/appx/manifest/virtualization/windows10"
  IgnorableNamespaces="uap uap5 desktop desktop4 rescap virtualization">

  <Identity Name="{IDENTITY_NAME}" Publisher="{PUBLISHER}" Version="{VERSION}.0" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>{DISPLAY_NAME}</DisplayName>
    <PublisherDisplayName>{PUBLISHER_DISPLAY_NAME}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <virtualization:FileSystemWriteVirtualization>
      <virtualization:ExcludedDirectories>
        <virtualization:ExcludedDirectory>$(KnownFolder:RoamingAppData)\Dusk</virtualization:ExcludedDirectory>
        <virtualization:ExcludedDirectory>$(KnownFolder:LocalAppData)\Dusk</virtualization:ExcludedDirectory>
      </virtualization:ExcludedDirectories>
    </virtualization:FileSystemWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <!-- Multiple instances: required by the console alias. Dusk itself
         keeps one daemon per session (a second start hands over, SPEC-NFR-2). -->
    <Application Id="Dusk" Executable="duskd.exe" EntryPoint="Windows.FullTrustApplication"
      desktop4:SupportsMultipleInstances="true">
      <uap:VisualElements
        DisplayName="{DISPLAY_NAME}"
        Description="Control your monitors from the tray: presets, hotkeys, brightness, input and colour."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="duskd.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="DuskStartup" Enabled="false" DisplayName="{DISPLAY_NAME}" />
        </desktop:Extension>
        <!-- `dusk` in terminals. On the main app (not a separate one): the Store
             does not allow apps hidden from the Start menu ("headless"). -->
        <uap5:Extension Category="windows.appExecutionAlias" Executable="dusk.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias desktop4:Subsystem="console">
            <uap5:ExecutionAlias Alias="dusk.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
